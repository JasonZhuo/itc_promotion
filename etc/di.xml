    <preference for="Itc\Promotion\Api\Data\ReplaceResultInterface" type="Itc\Promotion\Model\ReplaceResult"/>
    <type name="Itc\Promotion\Ui\Component\Form\DataProvider">
        <arguments>
            <argument name="name" xsi:type="string">itc_promotion_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">sku</argument>
            <argument name="requestFieldName" xsi:type="string">sku</argument>
