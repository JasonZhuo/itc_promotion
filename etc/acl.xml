    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Itc_Promotion::promotion" title="ITC Promotion" sortOrder="80">
                    <resource id="Itc_Promotion::config" title="Promotion Configuration" sortOrder="10"/>
                    <resource id="Itc_Promotion::manage" title="Manage Promotion Products" sortOrder="20"/>
                    <resource id="Itc_Promotion::update" title="Replace Promotion List via API" sortOrder="30"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
